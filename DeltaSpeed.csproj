<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      ATAS requires .NET 8 Class Library.
      UseWPF=true unlocks System.Windows.Media.Color for the indicator settings UI.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DeltaSpeed</AssemblyName>
    <RootNamespace>DeltaSpeedIndicator</RootNamespace>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!--
    IMPORTANT: Replace the HintPath values below with the actual path where ATAS
    is installed on your machine.  The default install location is shown.

    Both DLLs live in the same ATAS install folder.
  -->
  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>C:\Program Files (x86)\ATAS Platform\ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utils.Common">
      <HintPath>C:\Program Files (x86)\ATAS Platform\Utils.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
